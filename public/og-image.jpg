<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a0f;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0a0a0f;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="textGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#00d4ff;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#7c3aed;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ffd700;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <circle cx="200" cy="150" r="180" fill="#00d4ff" opacity="0.05"/>
  <circle cx="1000" cy="480" r="200" fill="#7c3aed" opacity="0.05"/>
  <text x="600" y="280" text-anchor="middle" font-family="system-ui, sans-serif" font-size="72" font-weight="bold" fill="url(#textGrad)">La Elite PvP</text>
  <text x="600" y="350" text-anchor="middle" font-family="system-ui, sans-serif" font-size="28" fill="#ffffffaa">Clan Competitivo Free Fire</text>
  <text x="600" y="420" text-anchor="middle" font-family="system-ui, sans-serif" font-size="20" fill="#ffffff66">Tops • Rankings • Torneos • PagoStore Premium</text>
  <polygon points="600,520 580,560 620,560" fill="#ffd700"/>
</svg>